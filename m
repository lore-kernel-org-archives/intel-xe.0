> -	/* Update stream->oa_buffer.tail to allow any final reports to be read */
> -	if (xe_oa_buffer_check_unlocked(stream))
> -		wake_up(&stream->poll_wq);
>  }
>
>  static int xe_oa_enable_preempt_timeslice(struct xe_oa_stream *stream)
