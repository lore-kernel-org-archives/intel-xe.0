index 69098194cef8..6eec7f4490df 100644
--- a/drivers/gpu/drm/xe/xe_pci.c
+++ b/drivers/gpu/drm/xe/xe_pci.c
@@ -74,6 +74,7 @@ struct xe_device_desc {
 	bool has_asid;
 	bool has_link_copy_engine;
 	bool has_gt_error_vectors;
+	bool has_mem_sparing;
 };
 
 __diag_push();
