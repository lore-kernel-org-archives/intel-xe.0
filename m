> > > +static int guc_exec_queue_set_no_preempt(struct xe_exec_queue *q)
> > > +{
> > > +	struct xe_sched_msg *msg;
> > > +
> > > +	if ((!q->sched_props.preempt_timeout_us && !q->sched_props.timeslice_us) ||
