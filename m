+#define GSC_UNCOR_FW_REPORTED_ERR           (6)
+#define GSC_UNCOR_UCODE_PARITY_ERR          (5)
+#define GSC_UNCOR_ROM_PARITY_ERR            (4)
+#define GSC_UNCOR_WDG_TIMEOUT_ERR           (3)
