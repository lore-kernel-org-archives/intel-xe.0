> > > +	if ((q->sched_props.preempt_timeout_us ==
> > > +	    q->hwe->eclass->sched_props.preempt_timeout_us &&
> > > +	    q->sched_props.timeslice_us == q->hwe->eclass->sched_props.timeslice_us) ||
